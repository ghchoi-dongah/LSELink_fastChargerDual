<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="1024dp"
    android:layout_height="768dp"
    tools:context=".pages.RfcardTestFragment">

    <TextView
        android:id="@+id/txtRfTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/rfcardTitle"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="RF TEST 버튼 클릭 후\n리더기에 카드를 태깅해 주세요."
        android:textSize="36sp"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/txtRfTitle" />

    <TextView
        android:id="@+id/txtCardNum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="300dp"
        android:gravity="center_horizontal"
        android:textSize="36sp"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"/>

    <Button
        android:id="@+id/btnRfTest"
        android:layout_width="300dp"
        android:layout_height="120dp"
        android:layout_marginEnd="20dp"
        android:text="@string/rfTest"
        android:textSize="36sp"
        android:textColor="@color/white"
        android:background="@drawable/shape_btn_blue"
        app:layout_constraintTop_toTopOf="@id/btnExit"
        app:layout_constraintEnd_toStartOf="@id/btnExit" />

    <Button
        android:id="@+id/btnExit"
        android:layout_width="300dp"
        android:layout_height="120dp"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="30dp"
        android:text="@string/btnConfigExit"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:background="@drawable/selector_default_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:backgroundTint="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>